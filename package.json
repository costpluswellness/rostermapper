{
	"name": "rostermapper",
	"version": "1.0.0-beta.1",
	"description": "Map any healthcare provider roster file (xlsx, xls, csv) to a standard schema: map, standardize, validate against NPPES and the Census geocoder, and export.",
	"keywords": [
		"healthcare",
		"provider",
		"roster",
		"directory",
		"npi",
		"nppes",
		"nucc",
		"census",
		"xlsx",
		"csv",
		"cli"
	],
	"license": "MIT",
	"author": "Ramzy Alamine",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/costpluswellness/rostermapper.git"
	},
	"homepage": "https://github.com/costpluswellness/rostermapper#readme",
	"bugs": "https://github.com/costpluswellness/rostermapper/issues",
	"type": "module",
	"bin": {
		"rostermapper": "dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./workbook": {
			"types": "./dist/workbook.d.ts",
			"default": "./dist/workbook.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"default": "./dist/node.js"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"NOTICE"
	],
	"scripts": {
		"cli": "tsx src/cli/bin.ts",
		"build": "rm -rf dist && tsup",
		"test": "node --import tsx --test test/*.test.ts",
		"typecheck": "tsc --noEmit",
		"schema": "node scripts/build-schema.ts",
		"schema:check": "node scripts/build-schema.ts --check",
		"nucc": "node scripts/build-nucc.ts",
		"check": "pnpm schema:check && pnpm typecheck && pnpm test && pnpm build",
		"prepublishOnly": "pnpm check"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.3.0",
	"dependencies": {
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"tsup": "^9.0.0",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"yaml": "^2.9.1"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
