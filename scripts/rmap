#!/bin/sh
# Run the CLI straight from src/: no build, no pnpm (pnpm adds about a second to every run).
# Put it on your PATH once, then run it from any folder:
#   ln -s "$PWD/scripts/rmap" ~/.local/bin/rmap      # or /usr/local/bin/rmap
#   rmap roster.xlsx            # saves output/RM_<file>_<sheet>.xlsx
root=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
exec node --import "$root/node_modules/tsx/dist/loader.mjs" "$root/src/cli/bin.ts" "$@"
